<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Без нативен apphost (.exe) — само dotnet.exe (споделен, вече доверен хост)
      изпълнява приложението през App.dll. На машини с корпоративен AppLocker/
      Defender Application Control, локално build-нат неподписан .exe често се
      блокира с "Access is denied", докато самият dotnet.exe е вече одобрен.
    -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaitBuster.Core\BaitBuster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Обученият модел пътува с приложението; регенерира се с BaitBuster.MlTraining. -->
    <None Include="..\..\models\phishing-model.zip" Link="models\phishing-model.zip"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
